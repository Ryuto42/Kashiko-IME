#!/bin/bash
# Kashiko installer: downloads the prebuilt app and system dictionary from the
# public release, verifies their SHA-256, and installs them for this user.
# Generated by scripts/package-release.sh; the digests below are pinned.
set -euo pipefail

BASE="https://github.com/@RELEASE_REPO@/releases/download"
TAG="@TAG@"
DICT_TAG="@DICT_TAG@"
APP_ZIP="@APP_ZIP@"
APP_ZIP_SHA256="@APP_ZIP_SHA256@"
DICT_TGZ_SHA256="@DICT_TGZ_SHA256@"
DICT_BIN_SHA256="@DICT_BIN_SHA256@"

INSTALL_DIR="$HOME/Library/Input Methods"
DATA_DIR="$HOME/Library/Application Support/com.kashiko.kashiko-im"

if [ "$(uname -s)" != "Darwin" ] || [ "$(uname -m)" != "arm64" ]; then
  echo "Kashiko requires macOS on Apple Silicon (arm64)." >&2
  exit 1
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

fetch() {
  curl -fL --proto '=https' --progress-bar -o "$tmp/$2" "$BASE/$1/$2"
  echo "$3  $tmp/$2" | shasum -a 256 -c -
}

echo "Downloading Kashiko ..."
fetch "$TAG" "$APP_ZIP" "$APP_ZIP_SHA256"
ditto -x -k "$tmp/$APP_ZIP" "$tmp/app"
xattr -dr com.apple.quarantine "$tmp/app/Kashiko.app" 2>/dev/null || true
mkdir -p "$INSTALL_DIR"
rm -rf "$INSTALL_DIR/Kashiko.app"
cp -a "$tmp/app/Kashiko.app" "$INSTALL_DIR/"

if [ -f "$DATA_DIR/dict.bin" ]; then
  echo "System dictionary already installed (skipping)."
else
  echo "Downloading system dictionary ..."
  fetch "$DICT_TAG" dict.tgz "$DICT_TGZ_SHA256"
  tar xzf "$tmp/dict.tgz" -C "$tmp" dict.bin
  echo "$DICT_BIN_SHA256  $tmp/dict.bin" | shasum -a 256 -c -
  mkdir -p "$DATA_DIR"
  cp "$tmp/dict.bin" "$DATA_DIR/"
fi

echo "Downloading conversion models ..."
"$INSTALL_DIR/Kashiko.app/Contents/MacOS/kashiko-imserver" --prefetch-models \
  || echo "WARNING: model download failed; it will be retried on first use."

killall KashikoIME 2>/dev/null || true
echo "Installed to $INSTALL_DIR/Kashiko.app"
echo "First install: log out and back in, then add Kashiko in System Settings > Keyboard > Input Sources."
